# Copy to .env and fill in. .env is gitignored — never commit real keys.

# OpenAQ v3 (free, instant registration at https://explore.openaq.org/register)
# Needed only for CPCB station discovery + recent/live observations.
# The S3 bulk archive backend (historical training data) needs no key.
OPENAQ_API_KEY=

# NASA FIRMS (free registration at https://firms.modaps.eosdis.nasa.gov/api/area/)
FIRMS_MAP_KEY=
