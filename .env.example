# Copy to .env and fill in. .env is gitignored — never commit real keys.

# OpenAQ v3 (free, instant registration at https://explore.openaq.org/register)
# Needed only for CPCB station discovery + recent/live observations.
# The S3 bulk archive backend (historical training data) needs no key.
OPENAQ_API_KEY=

# NASA FIRMS (free registration at https://firms.modaps.eosdis.nasa.gov/api/area/)
FIRMS_MAP_KEY=

# Where to mirror the forecast-run stores after each successful archive pass.
# Not a key — a path. Off by default and opt-in on purpose: copying data into a
# synced folder (OneDrive, Dropbox) sends it off the machine, and that is your
# call, not the script's.
#
# Why bother: cams_runs and meteo_runs are the only datasets in this project
# that cannot be re-fetched. There is no archived-forecast air-quality product,
# so they grow only by the daily job having run, and a disk failure in December
# costs the entire winter. They are ~250 KB/day, about 90 MB/year.
#
#   AIRSHED_BACKUP_DIR=D:\airshed-backup
#   AIRSHED_BACKUP_DIR=C:\Users\<you>\OneDrive\airshed-backup
AIRSHED_BACKUP_DIR=
